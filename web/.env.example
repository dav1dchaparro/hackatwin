# Copiar a web/.env.local (ignorado por git). La API key de 0xGasless NUNCA va al repo.
VITE_MODO=mock                     # mock | fuji
VITE_CHAIN_ID=43113
VITE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
VITE_EXPLORER=https://testnet.snowtrace.io
VITE_LLAVE_ADDRESS=                # vacío = usa deployments.fuji.json → llave.A (o ?llave=0x… en la URL)
VITE_PESOS_ADDRESS=                # vacío = usa deployments.fuji.json → mockPesos (o ?pesos=0x…)
VITE_KUMPLY_STORE=0xa3Bc5564A18e107807aF41fF2a5215Db050b22dD
VITE_OXGASLESS_API_KEY=            # dashboard de 0xGasless → proyecto Fuji (43113)
VITE_OXGASLESS_BUNDLER_URL=        # vacío = https://bundler.0xgasless.com/43113
VITE_OXGASLESS_PAYMASTER_URL=      # vacío = https://paymaster.0xgasless.com/v1/43113/rpc/<API key> [SIN VERIFICAR]
VITE_PAYMASTER_URL=                # opcional: solo si el staff habilita un lane para personas (pisa al anterior)
VITE_POLITICA_PATROCINIO=on        # off = la web manda userOps aunque la SA no esté verificada (P2-8)
VITE_OXGASLESS_DEBUG=false
