# Copiar a web/.env.local (ignorado por git). La API key de 0xGasless NUNCA va al repo.
# mock | fuji
VITE_MODO=mock
VITE_CHAIN_ID=43113
VITE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
VITE_EXPLORER=https://testnet.snowtrace.io
# vacío = usa src/abi/deployments.fuji.json -> llave.A (o ?llave=0x... en la URL)
VITE_LLAVE_ADDRESS=
# vacío = usa src/abi/deployments.fuji.json -> mockPesos (o ?pesos=0x... en la URL)
VITE_PESOS_ADDRESS=
# EOA del agente tier 5 (para el chip "agente verificado"); vacío = deployments.fuji.json -> cuentas.agente
VITE_AGENTE_ADDRESS=
VITE_KUMPLY_STORE=0xa3Bc5564A18e107807aF41fF2a5215Db050b22dD
# dashboard de 0xGasless -> proyecto Fuji (43113)
VITE_OXGASLESS_API_KEY=
# vacío = https://bundler.0xgasless.com/43113
VITE_OXGASLESS_BUNDLER_URL=
# vacío = https://paymaster.0xgasless.com/v1/43113/rpc/<API key> [SIN VERIFICAR]
VITE_OXGASLESS_PAYMASTER_URL=
# opcional: solo si el staff habilita un lane de patrocinio (pisa al anterior)
VITE_PAYMASTER_URL=
# off = la web manda userOps aunque la smart account no sea la dueña (P2-8)
VITE_POLITICA_PATROCINIO=on
VITE_OXGASLESS_DEBUG=false
