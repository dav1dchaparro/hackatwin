# Copiá este archivo a keeper/.env y completalo. El .env real nunca se commitea.

# RPC de Avalanche Fuji (chainId 43113).
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Dirección de la Llave de Emergencia desplegada en Fuji (obligatoria).
LLAVE_ADDRESS=

# URL de la web, para los links de los avisos (/dueno y /heredero).
WEB_URL=http://localhost:5173

# Token del bot creado con @BotFather. Si falta, los avisos se imprimen por consola (modo seco).
TELEGRAM_BOT_TOKEN=

# chat_id de la dueña (sacalo con `npm run chat-id` después de mandarle /start al bot).
TELEGRAM_CHAT_ID_DUENO=

# Opcional: chat_id de cada heredero, alias=chat_id separados por coma (ej. tomas=123,lucia=456).
# Si falta, los avisos a herederos van al chat de la dueña con el prefijo [para <alias>].
TELEGRAM_CHAT_ID_HEREDEROS=

# Segundos antes del vencimiento en los que se avisa a la dueña (demo: 30 y 10).
UMBRALES_SEGUNDOS=30,10

# Opcional: alias=dirección para que los avisos digan nombres en vez de 0x....
ALIAS=marta=0x...,lucia=0x...,tomas=0x...,pablo=0x...,rosa=0x...

# Cada cuánto consulta el contrato (ms).
INTERVALO_MS=5000
