# Agente KUMPLY de la Llave. Copiá este archivo a agente/.env (ignorado por git) y completalo.
# Nunca subas claves al repo.

# RPC de Avalanche Fuji (C-Chain 43113). Público: https://api.avax-test.network/ext/bc/C/rpc
FUJI_RPC_URL=
# Contrato Llave a vigilar (deployments/fuji.json → llave.A).
LLAVE_ADDRESS=
# Clave de la EOA del agente (la que KUMPLY atestigua con tier 5). SOLO en agente/.env, nunca en archivos del repo.
AGENTE_PRIVATE_KEY=

# Cada cuánto mira la Llave (ms).
POLL_MS=5000
# Segundos restantes en los que se le recuerda al dueño que toque "Estoy bien" (demo: plazo de 60 s).
AVISOS_UMBRALES_S=30,10
# Web de la Llave; el link del dueño es ${WEB_URL}/dueno.
WEB_URL=

# Telegram (opcional): bot creado con @BotFather y chat id del dueño (ver README).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_DUENO=

# Mail con Resend (opcional).
RESEND_API_KEY=
EMAIL_DE=
EMAIL_DUENO=
# Herederos: 0xcuenta:mail separados por coma, ej. 0xabc...:lucia@example.com,0xdef...:tomas@example.com
EMAILS_HEREDEROS=

# Opcional: reescribe los avisos con Claude (la decisión nunca depende de esto).
ANTHROPIC_API_KEY=

# true = simula y avisa, pero no manda transacciones (no hace falta clave).
DRY_RUN=false
