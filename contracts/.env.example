# contracts/.env.example — variables de DeployLlave.s.sol y de los comandos de cast del README.
# Copiar a contracts/.env (está en .gitignore) y completar. NUNCA claves en archivos: la cuenta del deployer se
# importa una sola vez con `cast wallet import hackatwin-deployer --interactive` y se usa con --account.
# Una línea `VAR=` vacía significa "usar el valor por defecto" que indica el comentario.
# Los valores de ejemplo de DEMO_HEREDEROS y AGENTE_ADDRESS son cuentas públicas de prueba de anvil (solo sirven para
# la simulación local): reemplazarlas por las smart accounts reales de docs/cuentas.md antes de desplegar en Fuji.

# ── Red y cuenta ──
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
DEPLOYER_ACCOUNT=hackatwin-deployer      # nombre del keystore de `cast wallet import`
DEPLOYER_ADDRESS=                        # dirección pública del deployer (para --sender)

# ── KUMPLY ──
KUMPLY_STORE=0xa3Bc5564A18e107807aF41fF2a5215Db050b22dD   # AttestationStore oficial de Fuji
USAR_STORE_DEMO=false                    # plan B (P1-10): true = despliega DemoAttestationStore y emite tier 5 al agente
AGENTE_ADDRESS=0x90F79bf6EB2c4f870365E785982E1f101E93b906 # EOA del agente (tier 5). Obligatoria con USAR_STORE_DEMO=true
AGENTES_EXTRA=                           # store demo: más agentes tier 5, separados por comas (ej. el fixture 0x9f8F…)
EMPRESAS_EXTRA=                          # store demo: cuentas tier 4 (empresa), para la evidencia NotAgent(x,4)
STORE_DEMO_VIGENCIA_S=                   # store demo: vigencia de las atestaciones en segundos (vacío = 30 días)

# ── Token ──
PESOS_ADDRESS=                           # vacío = despliega un MockPesos nuevo

# ── Instancia de la Llave ──
LLAVE_INSTANCIA=A                        # A o B: clave bajo `llave` en el fragmento JSON para deployments/fuji.json
PERIODO_MINIMO=1                         # piso de los plazos. Demo: 1 s. Prod: 2592000 (30 días)
DEMO_DUENO=                              # SA 0xGasless de Marta. Vacío = el deployer (después: transferirDueno)
DEMO_HEREDEROS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8,0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC   # Lucía,Tomás
DEMO_BPS=6000,4000                       # mismo orden que DEMO_HEREDEROS; suman 10000
DEMO_INACTIVIDAD=60                      # segundos sin señal hasta "Vencida". Prod: 15552000 (180 días)
DEMO_GRACIA=30                           # segundos de gracia. Prod: 2592000 (30 días)
COMISION_BPS=100                         # comisión al liberar: 100 = 1% (máximo 100). Retirar es gratis
TESORERIA=                               # recibe la comisión. Vacío = el deployer
DEMO_SIEMBRA=1000000000000000000000000   # 1.000.000 mPESO (18 decimales). El deployer hace faucet + approve + depositar
